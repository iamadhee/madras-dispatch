---
/** A red rubber stamp. The one spot colour on the page. Use once per page at most. */
interface Props {
  text: string;
  tilt?: boolean;
}
const { text, tilt = true } = Astro.props;
---
<span class="stamp" data-tilt={tilt ? "" : undefined}>{text}</span>

<style>
  .stamp {
    display: inline-block;
    border: var(--rule-stamp);
    color: var(--color-stamp);
    font-family: var(--font-headline);
    font-size: var(--text-small);
    font-weight: var(--weight-headline);
    letter-spacing: var(--tracking-caps-wide);
    text-transform: uppercase;
    line-height: var(--leading-solid);
    padding: var(--space-inline) var(--space-inline-loose);
    mix-blend-mode: var(--blend-stamp);
    white-space: nowrap;
  }
  .stamp[data-tilt] { transform: rotate(var(--stamp-tilt, -5deg)); } /* the press nudges the tilt on every impression */
</style>
