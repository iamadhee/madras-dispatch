---
/**
 * Body copy, set the way a newspaper sets it: justified, hyphenated,
 * paragraphs indented rather than spaced. Optional column split, drop cap, dateline.
 * Do not combine `dropcap` with `dateline`; the dateline is the opening of the paragraph.
 */
interface Props {
  columns?: 1 | 2 | 3;
  dropcap?: boolean;
  dateline?: string;
  size?: "body" | "compact";
  /** Cap the measure at a comfortable line length. Off inside grid cells by default. */
  measure?: boolean;
  /** Print an end mark after the last paragraph. For a story that finishes on this page; a story that jumps gets a JumpLine instead. */
  end?: boolean;
}
const { columns = 1, dropcap = false, dateline, size = "body", measure = false, end = false } = Astro.props;
const datelineText = dateline ? `${dateline.toUpperCase()} — ` : undefined;
---
<div
  class="prose"
  data-columns={columns}
  data-size={size}
  data-dropcap={dropcap && !dateline ? "" : undefined}
  data-measure={measure ? "" : undefined}
  data-end={end ? "" : undefined}
  style={datelineText ? `--dateline: "${datelineText}"` : undefined}
>
  <slot />
</div>

<style>
  .prose {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
    hyphenate-limit-chars: 7 3 3;
    orphans: 2;
    widows: 2;
    column-gap: var(--space-gutter);
    column-rule: var(--rule-hairline);
  }
  .prose[data-size="compact"] { font-size: var(--text-compact); line-height: var(--leading-tight); }
  .prose[data-measure] { max-width: var(--measure-body); }
  /* Columns collapse on their own when the cell is too narrow for the measure. */
  .prose[data-columns="2"] { columns: var(--measure-column) 2; }
  .prose[data-columns="3"] { columns: var(--measure-column) 3; }

  /* Paragraphs may split at the column break, as they do in print; widows and orphans are held to two lines. */
  .prose :global(p) { margin: 0; }
  /* A picture inside the copy heads the first column and never splits. */
  .prose :global(figure) { break-inside: avoid-column; margin-bottom: var(--space-stack); }
  .prose :global(p + p) { text-indent: 1.4em; }
  .prose :global(p:first-of-type)::before {
    content: var(--dateline, none);
    font-weight: var(--weight-headline);
    letter-spacing: var(--tracking-caps);
    font-size: var(--text-compact);
  }
  .prose[data-end] > :global(p:last-of-type)::after {
    content: "\00a0\25A0" / "";
    font-size: var(--text-fine);
    vertical-align: baseline;
  }
  .prose[data-dropcap] :global(p:first-of-type)::first-letter {
    font-family: var(--font-headline);
    font-weight: var(--weight-headline);
    font-size: 3.4em;
    line-height: 0.78;
    float: left;
    padding: 0.08em 0.12em 0 0;
  }

  .prose :global(h2), .prose :global(h3) {
    font-family: var(--font-headline);
    font-weight: var(--weight-headline);
    font-size: var(--text-headline-brief);
    line-height: var(--leading-headline);
    text-align: center;
    margin: var(--space-stack-loose) 0 var(--space-stack);
    break-after: avoid-column;
  }
  .prose :global(h3) { font-size: var(--text-body); text-transform: uppercase; letter-spacing: var(--tracking-caps); }

  .prose :global(ul), .prose :global(ol) {
    margin: var(--space-stack) 0;
    padding-left: 1.4em;
    text-align: left;
  }
  .prose :global(li + li) { margin-top: var(--space-hair); }

  .prose :global(blockquote) {
    margin: var(--space-stack-loose) 0;
    padding-left: var(--space-stack-loose);
    border-left: var(--rule-medium);
    font-style: italic;
  }

  .prose :global(pre) {
    font-size: var(--text-small);
    line-height: var(--leading-tight);
    background: var(--color-paper-tint);
    padding: var(--space-stack);
    overflow-x: auto;
    text-align: left;
    hyphens: none;
    margin: var(--space-stack) 0;
    break-inside: avoid-column;
  }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(hr) { border: 0; border-top: var(--rule-hairline); margin: var(--space-stack-loose) 0; }
  .prose :global(table) { border-collapse: collapse; width: 100%; font-size: var(--text-compact); text-align: left; }
  .prose :global(th), .prose :global(td) { padding: var(--space-inline) 0; border-bottom: var(--rule-hairline-soft); }
</style>
