---
import { getCollection, render } from "astro:content";
import Section from "../layouts/Section.astro";
import Grid from "../components/Grid.astro";
import Col from "../components/Col.astro";
import Stack from "../components/Stack.astro";
import Story from "../components/Story.astro";
import Headline from "../components/Headline.astro";
import Meta from "../components/Meta.astro";
import Byline from "../components/Byline.astro";
import Prose from "../components/Prose.astro";
import Links from "../components/Links.astro";
import Ledger from "../components/Ledger.astro";
import Box from "../components/Box.astro";
import { site } from "../site";
import { stars } from "../lib/github";
import Figure from "../components/Figure.astro";
import type { ImageMetadata } from "astro";
import influencer from "../assets/projects/llm-influencer.png";
import docify from "../assets/projects/docify.png";
import promptster from "../assets/sites/promptster.jpg";
import tldr from "../assets/sites/tldr.jpg";
import twp from "../assets/sites/twp.jpg";
import tenure from "../assets/sites/tenure.jpg";

/** Pictures filed with each story. Mugshots float into the text; plates head the first column of it. */
const pictures: Record<string, { src: ImageMetadata; alt: string; caption: string; credit: string; variant: "plate" | "mug" }> = {
  "llm-influencer": { src: influencer, alt: "The LLM Influencer mascot, a figure in a suit lit in blue and red", caption: "The influencer. Not a real person, which was the point.", credit: "Artwork: project repository", variant: "mug" },
  docify: { src: docify, alt: "The Docify logo, an isometric cluster of blocks with trees on top", caption: "Docify's logo. The README beneath it was written by the tool.", credit: "Artwork: project repository", variant: "mug" },
  promptster: { src: promptster, alt: "Promptster's home page, headed 'Get AI to build what you actually meant'", caption: "Promptster on opening day. Three paths, no account, instant marks.", credit: "Screenshot: this paper", variant: "plate" },
  tldr: { src: tldr, alt: "tldr's home page, headed 'The hard parts of tech, five minutes at a time'", caption: "tldr, with its first lesson on IP addresses waiting at the door.", credit: "Screenshot: this paper", variant: "plate" },
  "the-watch-project": { src: twp, alt: "The Watch Project atelier with a round steel watch on a blue dial", caption: "The atelier at The Watch Project, mid-build. Round case, blue dial, steel bracelet.", credit: "Screenshot: this paper", variant: "plate" },
  tenure: { src: tenure, alt: "Tenure's home page, headed 'How long will your IT job last?', beside a stamp marked 'Not assessed'", caption: "Tenure's application form, before the reader has answered. The stamp waits for a score.", credit: "Screenshot: this paper", variant: "plate" },
};

const projects = (await getCollection("projects")).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.year - a.data.year;
});
const stories = await Promise.all(projects.map(async (entry) => ({ entry, Content: (await render(entry)).Content, stars: await stars(entry.data.repo, entry.data.stars) })));
const links = (p: (typeof projects)[number]) => [
  ...(p.data.repo ? [{ label: "Repository", href: p.data.repo }] : []),
  ...(p.data.url ? [{ label: "Site", href: p.data.url }] : []),
];
const statusWord = site.statusLabel;
---
<Section
  section="/technology"
  description={`Side projects by ${site.person.name}: language-model tools and four small websites.`}
  standfirst="Side projects, open-source tools, and the small websites that keep appearing."
>
  <Grid>
    <Col span={4}>
      {stories.map(({ entry, Content, stars: count }, i) => (
        <Story id={entry.id} last={i === stories.length - 1}>
          <Headline level={i === 0 ? "lead" : "secondary"} as="h2" kicker={entry.data.title} deck={entry.data.deck}>
            {entry.data.headline}
          </Headline>
          <Byline author="Technology Desk" date={String(entry.data.year)} />
          <Meta items={[statusWord[entry.data.status], count ? `${count} ${count === 1 ? "star" : "stars"}` : undefined, entry.data.tech.join(", ")]} />
          <Prose columns={2} dropcap end>
            {pictures[entry.id]?.variant === "plate" && (
              <Figure src={pictures[entry.id].src} alt={pictures[entry.id].alt} caption={pictures[entry.id].caption} credit={pictures[entry.id].credit} width={640} height={400} position="top" />
            )}
            {pictures[entry.id]?.variant === "mug" && (
              <Figure variant="mug" src={pictures[entry.id].src} alt={pictures[entry.id].alt} caption={pictures[entry.id].caption} credit={pictures[entry.id].credit} width={240} height={240} />
            )}
            <Content />
          </Prose>
          {links(entry).length > 0 && <Links items={links(entry)} />}
        </Story>
      ))}
    </Col>

    <Col span={2} rule>
      <Stack gap="story">
        <Ledger
          caption="Index of projects"
          columns={["Project", "Year", "Status"]}
          rows={projects.map((p) => [p.data.title, String(p.data.year), statusWord[p.data.status]])}
        />
        <Box title="Place of manufacture" kind="tinted">
          <p>Everything on this page was written in Madras, on a laptop, over filter coffee. The city taught the editor statistics at Madras Christian College and computing at the University of Madras. The patience came from the traffic.</p>
        </Box>
        <Box title="Where the code lives" kind="ruled">
          <p>All public repositories are at <a href={site.social.github.url}>github.com/{site.social.github.handle}</a>. Pull requests are read. Issues are answered. Stars are counted, and reported here as news.</p>
        </Box>
      </Stack>
    </Col>
  </Grid>
</Section>
